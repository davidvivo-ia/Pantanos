---
interface Props {
  id: string;
  series: { label: string; values: [number, number][]; color?: string }[];
  yLabel?: string;
  height?: number;
}
const { id, series, yLabel = '', height = 240 } = Astro.props;
const dataJson = JSON.stringify(series);
---
<div id={id} class="w-full bg-white border border-slate-200 rounded-lg p-2" style={`height:${height + 24}px`}></div>
<script type="module" define:vars={{ id, dataJson, yLabel, height }}>
  import('https://cdn.jsdelivr.net/npm/uplot@1.6.31/dist/uPlot.esm.min.js').then(({ default: uPlot }) => {
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = 'https://cdn.jsdelivr.net/npm/uplot@1.6.31/dist/uPlot.min.css';
    document.head.appendChild(link);

    const series = JSON.parse(dataJson);
    if (!series.length || !series[0].values.length) {
      document.getElementById(id).innerHTML = '<p class="text-slate-500 text-sm p-4">Sin datos.</p>';
      return;
    }
    const xs = series[0].values.map((p) => p[0]);
    const ys = series.map((s) => s.values.map((p) => p[1]));
    const data = [xs, ...ys];

    const colors = ['#2b7295', '#dc2626', '#22c55e', '#f59e0b'];
    const opts = {
      width: document.getElementById(id).clientWidth,
      height,
      scales: { x: { time: true } },
      axes: [
        { stroke: '#475569' },
        { stroke: '#475569', label: yLabel, size: 60 },
      ],
      series: [
        { label: 'Fecha' },
        ...series.map((s, i) => ({
          label: s.label,
          stroke: s.color || colors[i % colors.length],
          width: 1.5,
          points: { show: false },
        })),
      ],
      cursor: { drag: { x: true, y: false } },
    };
    const u = new uPlot(opts, data, document.getElementById(id));
    window.addEventListener('resize', () => u.setSize({ width: document.getElementById(id).clientWidth, height }));
  });
</script>
