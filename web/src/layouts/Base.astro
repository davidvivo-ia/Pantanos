---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Datos abiertos de embalses, lluvia y rutas de senderismo en España' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased min-h-screen flex flex-col">
    <header class="border-b border-slate-200 bg-white">
      <nav class="max-w-7xl mx-auto px-4 py-3 flex items-center gap-6">
        <a href={import.meta.env.BASE_URL} class="font-bold text-agua-700 text-lg flex items-center gap-2">
          <span class="inline-block w-3 h-3 rounded-full bg-agua-500" aria-hidden></span>
          Pantanos
        </a>
        <a href={`${import.meta.env.BASE_URL}cuencas`} class="text-sm text-slate-700 hover:text-agua-700">Cuencas</a>
        <a href={`${import.meta.env.BASE_URL}embalses`} class="text-sm text-slate-700 hover:text-agua-700">Embalses</a>
        <a href={`${import.meta.env.BASE_URL}pluviometros`} class="text-sm text-slate-700 hover:text-agua-700">Pluviómetros</a>
        <span class="ml-auto text-xs text-slate-500">datos abiertos · MITECO · AEMET · OSM</span>
      </nav>
    </header>
    <main class="flex-1 max-w-7xl mx-auto w-full px-4 py-6">
      <slot />
    </main>
    <footer class="border-t border-slate-200 bg-white mt-12">
      <div class="max-w-7xl mx-auto px-4 py-6 text-xs text-slate-600 space-y-1">
        <p>
          Fuentes: <a class="underline" href="https://www.miteco.gob.es/es/agua/temas/evaluacion-de-los-recursos-hidricos/boletin-hidrologico/">MITECO</a>,
          <a class="underline" href="https://opendata.aemet.es/">AEMET OpenData</a>,
          <a class="underline" href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> (ODbL),
          <a class="underline" href="https://es.wikipedia.org">Wikipedia</a> y Wikimedia Commons (CC-BY-SA),
          SAIH de las Confederaciones Hidrográficas.
        </p>
        <p>Sitio independiente sin afiliación oficial. Los datos son informativos y pueden contener errores; consulte las fuentes oficiales para usos críticos.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .leaflet-container { font-family: inherit; }
</style>
